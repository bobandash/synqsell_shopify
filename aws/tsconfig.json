{
  "compilerOptions": {
    "target": "es2020",
    "strict": true,
    "preserveConstEnums": true,
    "noEmit": false,
    "sourceMap": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./opt/nodejs",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@db/*": ["../prisma/*"]
    }
  },
  "exclude": ["node_modules"]
}
